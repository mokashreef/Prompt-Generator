# Prompt Generator — Environment Configuration Example
#
# NOTE: Prompt Generator is a 100% client-side web application.
# Sensitive API keys should NEVER be committed to this repository or bundled into public builds.
#
# When running locally or deploying on static hosts (GitHub Pages, Vercel, Netlify),
# users configure their own API keys via the in-app "AI Settings" modal, which persists
# credentials strictly in their browser's local storage (localStorage).

# Default AI Provider (pollinations | openai | ollama | deterministic)
DEFAULT_AI_PROVIDER=pollinations

# Optional: Pollinations AI API Key (required when anonymous IP quota is exhausted)
# Get a free key at: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# Optional: Groq / OpenRouter / OpenAI API Key for OpenAI-Compatible Provider
# Groq (Generous free tier): https://console.groq.com/keys
# OpenRouter (Free open-weight models available): https://openrouter.ai/keys
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile

# Optional: Local Ollama Endpoint (100% private, runs on your local machine)
# Download Ollama: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:latest

# Local Development Server Port
PORT=8080
